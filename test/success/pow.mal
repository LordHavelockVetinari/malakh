Main -> {
    out (0 ^ 0)
    out (0 ^ 1)
    out (0 ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
    AssertErr { 0 ^ -1 }
    out (1 ^ 0)
    out (1 ^ 1)
    out (1 ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
    out (1 ^ -1)
    out (1 ^ -1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
    out (2 ^ 0)
    out (2 ^ 1)
    out (2 ^ 2)
    out (2 ^ 3)
    out (2 ^ 10)
    out (2 ^ 100)
    AssertErr { 2 ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111 }
    AssertErr { 2 ^ -1 }
    AssertErr { 2 ^ -1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111 }
    out ((-1) ^ 0)
    out ((-1) ^ 1)
    out ((-1) ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
    out ((-1) ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111112)
    out ((-1) ^ -1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
    out ((-1) ^ -1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111112)
    out ((-3) ^ 10)
    out ((-3) ^ 11)
    out (2.0 ^ 2)
    out (2 ^ 2.0)
    out (2.0 ^ 2.0)
    out (2.0 ^ -2.0)
    out (2.0 ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
    out ((-2.0) ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
    out ((-2.0) ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111112)
    out (Infinity ^ 0)
    out (Infinity ^ 1)
    out (Infinity ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
    out (Infinity ^ -Infinity)
    out (2 ^ Infinity)
    out (2 ^ -Infinity)
    out ((-Infinity) ^ -2)
    out ((-Infinity) ^ -1)
    out ((-Infinity) ^ -0.5)
    out ((-Infinity) ^ -0.0)
    out ((-Infinity) ^ 0.0)
    out ((-Infinity) ^ 0.5)
    out ((-Infinity) ^ 1)
    out ((-Infinity) ^ 2)
    out (NaN ^ 1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111)
    out (NaN ^ 1)
    out (NaN ^ 0)
    out (NaN ^ 0.0)
    out (NaN ^ -0.0)
    out (NaN ^ (-1))
    out (0 ^ NaN)
    out (1 ^ NaN)
    out ((-1) ^ NaN)
    out (1.0 ^ NaN)
    out ((-1.0) ^ NaN)
    out (1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111 ^ NaN)
    out (1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111 ^ 2)
    AssertErr { "" ^ "" }
    AssertErr { "" ^ .Foo }
    AssertErr { 1 ^ "" }
    AssertErr { 1 ^ .Foo }
    AssertErr { 1 ^ {} }
    AssertErr { "" ^ 0.0 }
    AssertErr { .Foo ^ 1 }
    AssertErr { {} ^ 1 }

    out [Math::ModPow 179 65 123]
    out [Math::ModPow (-67) 65 123]
    out [Math::ModPow 831761908673089715008503436934675468 965083198513778822159282023126814619 237855473847631197445775518253182847]
    
    while i := [Range (-10) .To 10] {
        while j := [Range 10] {
            while k := [Range 1 .To 10] {
                Assert ([Math::ModPow i j k] == (i ^ j % k + k) % k)
            }
        }
    }

    AssertErr { Math::ModPow "" }
    AssertErr { Math::ModPow 1.0 }
    AssertErr { Math::ModPow 1 1.0 }
    AssertErr { Math::ModPow 1 (-1) }
    AssertErr { Math::ModPow 1 1 1.0 }
    AssertErr { Math::ModPow 1 1 (-1) }
    AssertErr { Math::ModPow 1 1 0 }
}
