Main -> {
    out [Range 3]...
    out [Range 1 .To 3]...
    out [Range 1 .Through 3]...
    out [Range 3 .To 18 .Step 5]...
    out [Range 3 .Step 5 .Through 18]...
    r := Range Infinity
    out [r] [r] [r] [r]
    out [Range 5 .Step (-1)]...
    out [Range (-5) .Step (-1)]...
    out [Range (-10) .To (-31) .Step (-7)]...
    out [Range (-10) .Through (-31) .Step (-7)]...
}
