Main -> {
    list := List
    push := list .Push
    push .A .B .C
    out [list .Each]...
    out [list .Length]
    push .D .E
    out [list .Each]...
    out [list .Length]
    list .Clear
    list .Push 666
    out [list .Each]...
    out [list .Length]
    list .Push 777 888
    out [list .Pop]
    list .Push 999
    out [list .Pop] [list .Pop] [list .Pop]
    out [list .Length]
}
