Main := {
    out "EQUALS"
    AssertStop { 1    == "1" }
    AssertStop { 1    == .One }
    AssertStop { 1    == {} }
    AssertStop { 1.0  == "1" }
    AssertStop { 1.0  == .One }
    AssertStop { 1.0  == {} }
    AssertStop { "1"  == 1 }
    AssertStop { "1"  == 1.0 }
    AssertStop { "1"  == .One }
    AssertStop { "1"  == {} }
    AssertStop { "1"  == "1" }
    AssertStop { .One == 1 }
    AssertStop { .One == 1.0 }
    AssertStop { .One == "1" }
    AssertStop { .One == {} }
    AssertStop { {}   == 1 }
    AssertStop { {}   == 1.0 }
    AssertStop { {}   == "1" }
    AssertStop { {}   == .One }
    out "NOT EQUALS"
    AssertStop { 1    != "1" }
    AssertStop { 1    != .One }
    AssertStop { 1    != {} }
    AssertStop { 1.0  != "1" }
    AssertStop { 1.0  != .One }
    AssertStop { 1.0  != {} }
    AssertStop { "1"  != 1 }
    AssertStop { "1"  != 1.0 }
    AssertStop { "1"  != .One }
    AssertStop { "1"  != {} }
    AssertStop { "1"  != "1" }
    AssertStop { .One != 1 }
    AssertStop { .One != 1.0 }
    AssertStop { .One != "1" }
    AssertStop { .One != {} }
    AssertStop { {}   != 1 }
    AssertStop { {}   != 1.0 }
    AssertStop { {}   != "1" }
    AssertStop { {}   != .One }
    out "LESS THAN"
    AssertErr { 1    < "1" }
    AssertErr { 1    < .One }
    AssertErr { 1    < {} }
    AssertErr { 1.0  < "1" }
    AssertErr { 1.0  < .One }
    AssertErr { 1.0  < {} }
    AssertErr { "1"  < 1 }
    AssertErr { "1"  < 1.0 }
    AssertErr { "1"  < .One }
    AssertErr { "1"  < {} }
    AssertErr { .One < 1 }
    AssertErr { .One < 1.0 }
    AssertErr { .One < "1" }
    AssertErr { .One < {} }
    AssertErr { {}   < 1 }
    AssertErr { {}   < 1.0 }
    AssertErr { {}   < "1" }
    AssertErr { {}   < .One }
    AssertErr { {}   < {} }
    out "GREATER THAN"
    AssertErr { 1    > "1" }
    AssertErr { 1    > .One }
    AssertErr { 1    > {} }
    AssertErr { 1.0  > "1" }
    AssertErr { 1.0  > .One }
    AssertErr { 1.0  > {} }
    AssertErr { "1"  > 1 }
    AssertErr { "1"  > 1.0 }
    AssertErr { "1"  > .One }
    AssertErr { "1"  > {} }
    AssertErr { .One > 1 }
    AssertErr { .One > 1.0 }
    AssertErr { .One > "1" }
    AssertErr { .One > {} }
    AssertErr { {}   > 1 }
    AssertErr { {}   > 1.0 }
    AssertErr { {}   > "1" }
    AssertErr { {}   > .One }
    AssertErr { {}   > {} }
    out "LESS OR EQUAL"
    AssertErr { 1    <= "1" }
    AssertErr { 1    <= .One }
    AssertErr { 1    <= {} }
    AssertErr { 1.0  <= "1" }
    AssertErr { 1.0  <= .One }
    AssertErr { 1.0  <= {} }
    AssertErr { "1"  <= 1 }
    AssertErr { "1"  <= 1.0 }
    AssertErr { "1"  <= .One }
    AssertErr { "1"  <= {} }
    AssertErr { .One <= 1 }
    AssertErr { .One <= 1.0 }
    AssertErr { .One <= "1" }
    AssertErr { .One <= {} }
    AssertErr { {}   <= 1 }
    AssertErr { {}   <= 1.0 }
    AssertErr { {}   <= "1" }
    AssertErr { {}   <= .One }
    AssertErr { {}   <= {} }
    out "GREATER OR EQUAL"
    AssertErr { 1    >= "1" }
    AssertErr { 1    >= .One }
    AssertErr { 1    >= {} }
    AssertErr { 1.0  >= "1" }
    AssertErr { 1.0  >= .One }
    AssertErr { 1.0  >= {} }
    AssertErr { "1"  >= 1 }
    AssertErr { "1"  >= 1.0 }
    AssertErr { "1"  >= .One }
    AssertErr { "1"  >= {} }
    AssertErr { .One >= 1 }
    AssertErr { .One >= 1.0 }
    AssertErr { .One >= "1" }
    AssertErr { .One >= {} }
    AssertErr { {}   >= 1 }
    AssertErr { {}   >= 1.0 }
    AssertErr { {}   >= "1" }
    AssertErr { {}   >= .One }
    AssertErr { {}   >= {} }
    out "DONE"
}
