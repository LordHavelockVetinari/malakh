Main -> {
    s := in
    out [String::Length s]
    out [String::Bytes s]...
    builder := String::FromBytes 97 98 99
    out ([builder] == "abc")
    out ([builder] == "abc")
    builder 32 240 159 145 190 255
    out ([builder] == s)
    out [String::Words "The quick, brown \n\nfox jumps\n over the lazy dog."]...
    out [String::FromWords "" "" "abc" "def" 1]
    out [String::Lines "Foo\r\nBar\nBaz"]...
    out [String::Length [String::Lines "Foo\r\nBar\nBaz"]]
    out [String::FromLines 1 2 "3\n4"]

    AssertErr { String::Bytes 1 }
    AssertErr { String::FromBytes 1000 }
    AssertErr { String::FromBytes (-1) }
    AssertErr { String::FromBytes 999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999 }
    AssertErr { String::FromBytes "" }
    AssertErr { String::Length 1 }
    AssertErr { String::Lines 1 }
    AssertErr { String::Slice 1 }
    AssertErr { String::Slice "" .Foo }
    AssertErr { String::Slice "" .To "" }
    AssertErr { String::Slice "" .Step 1 }
    AssertErr { String::Slice "" .To 1 .To 1 }
    AssertErr { String::Slice "" .From 1 .From 1 }
    AssertErr { [String::Slice "a"] }
    AssertErr { String::Words 1 }
    AssertErr { String::Words "\xff" }
    AssertErr { String::Words "\x80" }
}
