Main -> {
    s := in
    out [String::Length s]
    out [String::Bytes s]...
    builder := String::FromBytes 97 98 99
    out ([builder] == "abc")
    out ([builder] == "abc")
    builder 32 240 159 145 190 255
    out ([builder] == s)
    out [String::Words "The quick, brown \n\nfox jumps\n over the lazy dog."]...
    out [String::FromWords "" "" "abc" "def" 1]
    out [String::Lines "Foo\r\nBar\nBaz"]...
    out [String::Length [String::Lines "Foo\r\nBar\nBaz"]]
    out [String::FromLines 1 2 "3\n4"]

    AssertErr { String::Bytes 1 }
    AssertErr { String::FromBytes 1000 }
    AssertErr { String::FromBytes (-1) }
    AssertErr { String::FromBytes 999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999 }
    AssertErr { String::FromBytes "" }
    AssertErr { String::Length 1 }
    AssertErr { String::Lines 1 }
    AssertErr { String::Slice 1 }
    AssertErr { String::Slice "" .Foo }
    AssertErr { String::Slice "" .To "" }
    AssertErr { String::Slice "" .Step 1 }
    AssertErr { String::Slice "" .To 1 .To 1 }
    AssertErr { String::Slice "" .From 1 .From 1 }
    AssertErr { [String::Slice "a"] }
    AssertErr { String::Words 1 }
    AssertErr { String::Words "\xff" }
    AssertErr { String::Words "\x80" }

    join := String::Join
    Assert ([Process::State join] == .In)
    join ", "
    out [join]
    join "x"
    out [join]
    join 1
    out [join]
    join 2
    out [join] [join]
    AssertErr { String::Join 1 }

    split := String::Split "a, b, c" ", "
    out [split]...
    out [String::Split "" "x"]...
    out [String::Split "a" "x"]...
    AssertErr { String::Split "abc" "" }
    AssertErr { String::Split "" "" }

    out [String::At "Hello, World!" 4]
    out [String::At "α" 0]
    out [String::At "α" 1]

    Assert ([Process::State (String::At "α" 2)] == .Stop)
    Assert ([Process::State (String::At "α" (2^64))] == .Stop)
    Assert ([Process::State (String::At "α" (-1))] == .Stop)
    Assert ([Process::State (String::At "α" (-(2^64)))] == .Stop)
    AssertErr (String::At "x" 0.0)

    out [String::CharAt "αβγδ" 0]
    out [String::CharAt "αβγδ" 2]
    out [String::CharAt "αβγδ" 4]
    out [String::CharAt "αβγδ" 6]
    out [String::CharAt "x🫍🦑y" 0]
    out [String::CharAt "x🫍🦑y" 1]
    out [String::CharAt "x🫍🦑y" 5]
    out [String::CharAt "x🫍🦑y" 9]

    Assert ([Process::State (String::CharAt "αβγδ" 5)] == .Stop)
    Assert ([Process::State (String::CharAt "αβγδ" 7)] == .Stop)
    Assert ([Process::State (String::CharAt "αβγδ" 8)] == .Stop)
    Assert ([Process::State (String::CharAt "αβγδ" (2^64))] == .Stop)
    Assert ([Process::State (String::CharAt "αβγδ" (-1))] == .Stop)
    Assert ([Process::State (String::CharAt "x🫍🦑y" 2)] == .Stop)
    Assert ([Process::State (String::CharAt "x🫍🦑y" 3)] == .Stop)
    Assert ([Process::State (String::CharAt "x🫍🦑y" 4)] == .Stop)
    Assert ([Process::State (String::CharAt "x🫍🦑y" 6)] == .Stop)
    Assert ([Process::State (String::CharAt "x🫍🦑y" 7)] == .Stop)
    Assert ([Process::State (String::CharAt "x🫍🦑y" 8)] == .Stop)
    Assert ([Process::State (String::CharAt "x🫍🦑y" 10)] == .Stop)
}
