Foo -> {
    if x, y := [{ out 1 2 }] {
        fork in
        x += 1
        y -= 1
        out x y
        if x, y = [{ out 3 }] {
            out "error!"
        }
        out x y
    }
}

Bar -> {
    y := 1
    while x, (y), z := [{ out 1 2 3 4 5 6 7 8 }] {
        out x y z
        if x == y {
            fork in
            x = 1; y = 1; z = 1
        }
    }
    out y
}

Baz -> {
    x, z := 1, 2
    while (x), y, (z) := [{ out 1 2 3 4 5 6 7 8 }] {
        out x y z
        if x == y {
            fork in
            x, y, z = 0, 0, 0
        }
    }
    out x z
}

Quux -> {
    x, z := 0, 0
    loop {
        (x), y, (z), w := in
        else {
            fork in
            out x y z w
            x, y, z, w = 0, 0, 0, 0
            break
        }
    }
}

Corge -> {
    y, w := 0, 0
    loop {
        x, (y), z, (w) := in
        else {
            fork in
            out x y z w
            x, y, z, w = 0, 0, 0, 0
            break
        }
    }
}

Main -> {
    out "Foo" [Foo .Spam]...
    out "Bar" [Bar]...
    out "Baz" [Baz]...
    out "Quux"
    quux := Quux 10 20 30 40 50 60
    if _ := [quux] {
        out "error"
    }
    out [quux .Spam]...
    out "Corge"
    corge := Corge 10 20 30 40 50 60
    if _ := [corge] {
        out "error"
    }
    out [corge .Spam]...
}
