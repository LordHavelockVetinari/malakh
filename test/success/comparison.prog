Main := {
    out "EQUALS"
    out (1 == 1)
    out (1 == 2)
    out ("foo" == "foo")
    out ("foo" == "bar")
    out (.Foo == .Foo)
    out (.Foo == .Bar)
    out (Main == Main)
    out ({} == {})
    out (1 == "foo")
    out ("foo" == 3)
    out (1 == .Foo)
    out (.Bar == 5)
    out (.Foo == "Foo")
    out (".Foo" == .Foo)
    out (1 == {})
    out ({} == 1)
    out ("foo" == {})
    out ({} == "bar")
    out (.Foo == {})
    out ({} == .Bar)
    out "NOT EQUALS"
    out (1 != 1)
    out (1 != 2)
    out ("foo" != "foo")
    out ("foo" != "bar")
    out (.Foo != .Foo)
    out (.Foo != .Bar)
    out (Main != Main)
    out ({} != {})
    out (1 != "foo")
    out ("foo" != 3)
    out (1 != .Foo)
    out (.Bar != 5)
    out (.Foo != "Foo")
    out (".Foo" != .Foo)
    out (1 != {})
    out ({} != 1)
    out ("foo" != {})
    out ({} != "bar")
    out (.Foo != {})
    out ({} != .Bar)
    out "LESS THAN"
    out (1 < 0)
    out (1 < 1)
    out (1 < 2)
    out ("b" < "a")
    out ("b" < "b")
    out ("b" < "c")
    out "GREATER THAN"
    out (1 > 0)
    out (1 > 1)
    out (1 > 2)
    out ("b" > "a")
    out ("b" > "b")
    out ("b" > "c")
    out "LESS OR EQUAL"
    out (1 <= 0)
    out (1 <= 1)
    out (1 <= 2)
    out ("b" <= "a")
    out ("b" <= "b")
    out ("b" <= "c")
    out "GREATER OR EQUAL"
    out (1 >= 0)
    out (1 >= 1)
    out (1 >= 2)
    out ("b" >= "a")
    out ("b" >= "b")
    out ("b" >= "c")
}
