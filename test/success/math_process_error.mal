    AssertErr { Math::Cot "" }
    AssertErr { Math::Exp "" }
    AssertErr { Math::Floor "" }
    AssertErr { Math::Floor Infinity }
    AssertErr { Math::Floor (-Infinity) }
    AssertErr { Math::Floor NaN }
