Main -> {
    while n := [{out 1 2 3 4 5 6 7 8}] {
        switch n - 1 {
        
        case 1:
            out "one"
        
        case 1 + 1:
            out "a pair"

        case 0:
            out "nothing"
        
        case 3, 2 * 2, 5:
            out "a little"
        
        default:
            out "a lot"

        }
    }
    switch 1 { case 0: case 1: case 2: out "???" }
    while n := [{out 1 2 3}] {
        switch n { case 1: out "one"; case 2: out "two"; case 3: out "three" }
    }

    // Previously caused a panic in the compiler.
    switch 1 {
        case 1:
            switch 2 { case 2: out "four" }
        default:
    }

    switch {} {
        default:
            out "done"
    }
    AssertErr { switch 1 { case 2: case 3: } }
    AssertErr { switch NaN { case NaN: } }
    AssertStop { switch NaN { default: } }
}
