Foo -> {
    x := 1
    y, z := fork in, 2
    w := 3
    x += 1
    y += 1
    z += 1
    w += 1
    out x y z w
}

Bar -> {
    x := 1
    y, z, w := in, [fork in], in
    else {
        out "error"
    }
    x += 1
    y += 1
    z += 1
    w += 1
    out x y z w
}

Baz -> {
    x := 1
    if y, z, w := in, [fork in], in {
        x += 1
        y += 1
        z += 1
        w += 1
        out x y z w
    }
}

Quux -> {
    x := 1
    while y, z, w := in, [fork in], in {
        x += 1
        y += 1
        z += 1
        w += 1
        out x y z w
    }
}

Main -> {
    out "Foo"
    foo := Foo
    out [foo 10]... [foo 20]...
    out "Bar"
    bar := Bar
    out [bar 2 { out 10 } 3]... [bar { out 20 } 3]...
    out "Baz"
    baz := Baz
    out [baz 2 { out 10 } 3]... [baz { out 20 } 3]...
    out "Quux"
    quux := Quux
    out [quux { out 10 } 2 3]... [quux { out 20 } 2 3]...
}
