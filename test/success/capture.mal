Main -> {
    x := 1
    out x
    ({ x = 2 })
    out x
    { x = in } 3
    out x
    setX := { x = fork in }
    setX "foo"
    out x
    setX "bar"
    out x
    x = 100
    foo := {out x x}
    x = 200
    out [foo] [foo]

    (x), y := "foo", "bar"
    swap := {
        out x y
        x, y = y, x
        out x y
    }
    x, y = "baz", "quux"
    out [swap] [swap] [swap] [swap] x y

    i := 10
    i += [{ i += 100; out i }]
    out i

    x = {
        x = 123
        User x
    }
    Assert [IsProcess x]

    const1, const2, const3 := 1, 2, 3
    ({ User const1 const2 const3 })
    ({ User const3 const2 const1 })
    ({ User ((const1 + const2) * (const2 + const3)) })
    ({
        const4, const5, const6 := 4, 5, 6
        ({
            const7, const8, const9 := 7, 8, 9
            ({
                User const1 const4 const7 const9 const6 const3 const2 const5 const8
            })
        })
    })
}
